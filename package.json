{
  "name": "telegram-client",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  },
  "//typescript": "pinned to 5.x: @opentui/core → bun-ffi-structs peers typescript ^5, so bun resolves 5.9.3 anyway and 7.x only adds a peer warning. Bump when that chain allows 7.",
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "bun run apps/cli/src/index.ts",
    "web": "bun run apps/web/src/server.ts",
    "test": "bun test",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci",
    "format": "biome check --write",
    "build": "bun build apps/cli/src/index.ts --compile --outfile dist/tg-client",
    "build:pages": "bun build apps/web/web/static.html --outdir dist/pages --public-path=./ --minify"
  }
}
