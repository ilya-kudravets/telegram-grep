{
  "name": "telegram-client",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "//overrides": "Both are in-range patch bumps their parents already allow; bun just won't re-resolve a transitive pin on its own. Drop an entry once expo/stryker ship a lockfile past it.",
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.23"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "bun run apps/cli/src/index.ts",
    "web": "bun run apps/web/src/server.ts",
    "mobile": "cd apps/mobile && bunx expo start",
    "test": "bun test",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci",
    "format": "biome check --write",
    "build": "bun build apps/cli/src/index.ts --compile --outfile dist/tg-client"
  }
}
