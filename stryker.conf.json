{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "bun test" },
  "checkers": ["typescript"],
  "plugins": ["@stryker-mutator/typescript-checker"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "off",
  "//ignorePatterns": ".claude/.agents hold symlinked, gitignored AI-skill docs — copying them into the sandbox is pointless and fails with ENOTSUP on a symlink",
  "ignorePatterns": [
    "apps/web/web",
    "data",
    "reports",
    "dist",
    ".claude",
    ".agents"
  ],
  "mutate": [
    "apps/web/src/api.ts",
    "apps/web/src/live.ts",
    "packages/bun/src/adapters/bun-sqlite.ts",
    "packages/bun/src/adapters/patterns-fs.ts",
    "packages/core/src/cache.ts",
    "packages/core/src/cache-memory.ts",
    "packages/core/src/deleter.ts",
    "packages/core/src/search.ts",
    "packages/core/src/sync.ts"
  ],
  "reporters": ["html", "json", "clear-text", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "tempDirName": ".stryker-tmp",
  "thresholds": { "high": 80, "low": 60, "break": 0 }
}
